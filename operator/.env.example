# Backend
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=operator-profile

# Brain (Groq Cloud — the only model)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Shared token between phone and the running session (single user)
OPERATOR_TOKEN=change-me

# Local Camoufox profile dir (mirrored to Supabase Storage)
CAMOUFOX_PROFILE_DIR=./.camoufox-profile

# Perception
MAX_ELEMENTS=120
